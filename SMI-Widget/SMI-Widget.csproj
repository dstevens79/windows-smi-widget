<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SMI_Widget</RootNamespace>
    <AssemblyName>SMI-Widget</AssemblyName>
    <ApplicationTitle>SMI Widget</ApplicationTitle>
    <Product>SMI Widget</Product>
    <Description>Windows desktop gadget for NVIDIA GPU telemetry via nvidia-smi.</Description>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF files free of WinForms/Drawing name clashes. Tray code imports them locally. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
